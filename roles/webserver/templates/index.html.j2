<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Platform Engineering Lab</title>
    <style>
        body { font-family: Arial, sans-serif; background-color: #0f172a; color: #f8fafc; text-align: center; padding-top: 80px; }
        .card { background: #1e293b; border-radius: 10px; padding: 30px; max-width: 500px; margin: auto; box-shadow: 0 4px 15px rgba(0,0,0,0.4); }
        h1 { color: #38bdf8; }
        span { color: #4ade80; font-weight: bold; }
    </style>
</head>
<body>
    <div class="card">
        <h1>Deploy via Ansible Concluido!</h1>
        <p>Servidor gerenciado: <span>{{ ansible_facts["hostname"] }}</span></p>
        <p>Sistema Operacional: <span>{{ ansible_facts["distribution"] }} {{ ansible_facts["distribution_version"] }}</span></p>
        <p>Endereco IP: <span>{{ ansible_facts["default_ipv4"]["address"] }}</span></p>
    </div>
</body>
</html>
